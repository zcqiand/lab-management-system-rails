# .env.production — lab-management-system-rails deploy 期键集（值由 deploy 注入；占位防兜底）

# L4.db.* 真跑需 dev 机器配真 PG（100.79.128.25:5432 + lab_prod 库）。
# 键名照抄 lab-management-system-springboot 镜像；rails 额外需要 SECRET_KEY_BASE
# （rails prod 启动必需）与 PG_* 五件套（rails 只认家族统一五件套连接形态）。

# —— Server ——
SERVER_PORT=5206

# —— Database（lab_dev 数据库, 全家族统一 PG_* 五件套） ——
PG_HOST=100.79.128.25
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=CHANGE_ME
PG_DATABASE=lab_prod

# —— JWT (HS256, ≥32B 硬约束, 全家族镜像同一 JWT_SIGNING_KEY) ——
# lab 自签 HS256 access/refresh token；SSO 链路 lab refresh token 内嵌 saas refresh token
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_AUDIENCE=lab-management-system-clients
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# —— saas OAuth (直连 saas IdP, ADR-0009; 恒真链) ——
LAB_SAAS_BASE_URL=http://localhost:5101
LAB_SSO_LOGIN_URL=http://localhost:5101
LAB_SAAS_CLIENT_ID=lab-management
LAB_SAAS_CLIENT_SECRET=CHANGE_ME
LAB_SAAS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
LAB_SSO_CALLBACK_REDIRECT=http://localhost:5202/login
LAB_SAAS_SERVICE_USER=alice
LAB_SAAS_SERVICE_PASSWORD=CHANGE_ME
LAB_SAAS_SERVICE_CLIENT_ID=lab-management
LAB_AUTH_DEV_PASSWORD=CHANGE_ME

# —— CORS allowed origins (SSO 跨域用; 勿写成 saas 家族的 SAAS_CORS_*) ——
# prod 域名与 aspnetcore/nextjs/springboot 三兄弟对齐（L0.5 synced key；2026-09-30 家族登记后抓出 localhost 漂移）
LAB_CORS_ALLOWED_ORIGINS=https://lab-vue.xiangru.uk,https://lab-react.xiangru.uk,https://lab-nextjs.xiangru.uk

# —— Rails session/verifier 密钥（rails 专属，prod 必填） ——
SECRET_KEY_BASE=CHANGE_ME

# —— DATABASE_URL：ActiveRecord 一等连接真源（AR boot 无条件优先读本键，
# 空/占位值会让 rails 启动即 URI 崩）——deploy env-file 必须给合法 postgresql:// 形态；
# PG_* 五件套是 database.yml 的 fallback 形态（无 DATABASE_URL 时生效） ——
DATABASE_URL=postgresql://user:password@pg-host:5432/lab_prod
DATABASE_NAME=lab_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME
